<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>RAG Simulator</title>

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display",
                     "Segoe UI", sans-serif;
        background: #f5f5f7;
        color: #1d1d1f;
    }

    header {
        padding: 55px 20px 35px;
        text-align: center;
        background: linear-gradient(180deg, #ffffff, #f5f5f7);
    }

    .badge {
        display: inline-block;
        padding: 7px 14px;
        border-radius: 30px;
        background: #e8e8ed;
        font-size: 13px;
        font-weight: 600;
        color: #555;
        margin-bottom: 18px;
    }

    h1 {
        font-size: clamp(38px, 6vw, 70px);
        letter-spacing: -3px;
        margin: 0;
        font-weight: 700;
    }

    .subtitle {
        max-width: 720px;
        margin: 18px auto 0;
        font-size: 19px;
        line-height: 1.5;
        color: #6e6e73;
    }

    .container {
        max-width: 1200px;
        margin: auto;
        padding: 20px;
    }

    .pipeline {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 10px;
        margin: 25px 0 35px;
    }

    .stage {
        padding: 13px 8px;
        text-align: center;
        border-radius: 15px;
        background: white;
        color: #777;

        font-weight: 600;
        border: 1px solid #e5e5e7;
        transition: .3s;
    }

    .stage.active {
        background: #1d1d1f;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(0,0,0,.15);
    }

    .card {
        background: rgba(255,255,255,.85);
        border: 1px solid #e5e5e7;
        border-radius: 28px;
        padding: 30px;
        margin-bottom: 22px;
        box-shadow: 0 8px 30px rgba(0,0,0,.04);
        backdrop-filter: blur(15px);
    }

    .card h2 {
        margin-top: 0;
        font-size: 25px;
